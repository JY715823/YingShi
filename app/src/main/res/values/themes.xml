<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.YingShi" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- ================================================================ -->
    <!-- 存活 style（Round 1 更新：引用新色板/drawable，FR-1/2/3/7/8）    -->
    <!-- Round 3 FR-13：已清理 11 个死代码 style + 10 个死 drawable        -->
    <!-- ================================================================ -->

    <!-- 相框容器（Console 横框上下竖排 / People 竖框对角错位） -->
    <style name="LifeConsoleWidgetMealFrame">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/widget_polaroid_frame</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="LifePeopleWidgetFrame">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/widget_polaroid_frame</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">0dp</item>
    </style>

    <!-- 照片预览区（相纸内的照片区域，5px 边） -->
    <style name="LifeConsoleWidgetPreview">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:layout_marginEnd">5dp</item>
        <item name="android:layout_marginTop">5dp</item>
    </style>

    <style name="LifePeopleWidgetPreview">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:layout_marginEnd">5dp</item>
        <item name="android:layout_marginTop">5dp</item>
    </style>

    <!-- 照片 ImageView -->
    <style name="LifeConsoleWidgetImage">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:scaleType">centerCrop</item>
    </style>

    <!-- 空状态（FR-8：虚线框+图标+文案） -->
    <style name="LifeConsoleWidgetEmpty">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/widget_empty_dash</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/widget_text_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:padding">8dp</item>
    </style>

    <!-- 透明点击区（覆盖整个照片区，用于点击打开查看器） -->
    <style name="LifeConsoleWidgetOpenZone">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@android:color/transparent</item>
        <item name="android:textSize">1sp</item>
    </style>

    <!-- ‹ › 翻页按钮（相纸白区底条内，灰色小图标，FR-4 Round 2 改为 ImageView） -->
    <style name="LifeConsoleWidgetEdgeButton">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:scaleType">centerInside</item>
    </style>

    <!-- 计数 meta（相纸白区中间） -->
    <style name="LifeConsoleWidgetFloatingMeta">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/widget_text_secondary</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- + 上传按钮（相纸白区，自己框，FR-4 Round 2 改为 ImageView） -->
    <style name="LifeConsoleWidgetFloatingButton">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:scaleType">centerInside</item>
    </style>

    <style name="LifePeopleWidgetUploadButton" parent="LifeConsoleWidgetFloatingButton" />

    <!-- 删除按钮（相纸白区，自己框，FR-4 Round 2 改为 ImageView） -->
    <style name="LifeConsoleWidgetFloatingDanger">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:scaleType">centerInside</item>
    </style>

    <!-- ================================================================ -->
    <!-- 新增 style（Round 1 FR-1/2/3/7/8）                               -->
    <!-- ================================================================ -->

    <!-- 相纸白区底条（26dp 高，horizontal，gravity=center_vertical，padding=4dp） -->
    <style name="LifeConsoleWidgetPolaroidBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!-- 大便胶囊容器（32dp 高，gravity=center_vertical） -->
    <style name="LifeConsoleWidgetBowelCapsule">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:background">@drawable/widget_bowel_capsule</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <!-- 账本胶囊容器（28dp×28dp，gravity=center） -->
    <style name="LifeConsoleWidgetLedgerCapsule">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:background">@drawable/widget_ledger_capsule</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- 胶带装饰（44dp×18dp，浮在相框顶部） -->
    <style name="LifeConsoleWidgetTape">
        <item name="android:layout_width">66dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_gravity">top|center_horizontal</item>
        <item name="android:layout_marginTop">-6dp</item>
    </style>

    <!-- 大便胶囊内文字（深石板，13sp，bold） -->
    <style name="LifeConsoleWidgetBowelCount">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/widget_title_accent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minWidth">14dp</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- 大便胶囊内标签（次要灰，9sp） -->
    <style name="LifeConsoleWidgetBowelLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/widget_text_secondary</item>
        <item name="android:textSize">9sp</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
    </style>

</resources>
