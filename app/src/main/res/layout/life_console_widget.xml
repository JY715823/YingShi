<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_backdrop"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_open_console"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="今日痕迹"
            android:textColor="#2962FF"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/widget_chip_light"
            android:gravity="center"
            android:minWidth="54dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="待刷新"
            android:textColor="#5F7D89"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="54dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_chip_light"
            android:gravity="center"
            android:text="刷新"
            android:textColor="#176D90"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Gradient accent bar under main title -->
    <TextView
        android:layout_width="72dp"
        android:layout_height="3dp"
        android:layout_marginTop="1dp"
        android:background="@drawable/widget_title_accent" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:text="吃饭"
        android:textColor="#00BFA5"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        style="@style/LifeConsoleWidgetMealFrame"
        android:layout_marginTop="2dp">

        <FrameLayout style="@style/LifeConsoleWidgetPreview">
            <ImageView
                android:id="@+id/widget_meal_partner_image"
                style="@style/LifeConsoleWidgetImage" />

            <TextView
                android:id="@+id/widget_meal_partner_empty"
                style="@style/LifeConsoleWidgetEmpty"
                android:text="对方还没记录" />

            <TextView
                android:id="@+id/widget_meal_partner_open"
                style="@style/LifeConsoleWidgetOpenZone" />

            <TextView
                android:id="@+id/widget_meal_partner_prev"
                style="@style/LifeConsoleWidgetEdgeButton"
                android:layout_gravity="start|center_vertical"
                android:text="‹" />

            <TextView
                android:id="@+id/widget_meal_partner_next"
                style="@style/LifeConsoleWidgetEdgeButton"
                android:layout_gravity="end|center_vertical"
                android:text="›" />

            <TextView
                android:id="@+id/widget_meal_partner_meta"
                style="@style/LifeConsoleWidgetFloatingMeta"
                android:layout_gravity="top|end"
                android:text="0" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        style="@style/LifeConsoleWidgetMealFrame"
        android:layout_marginTop="7dp">

        <FrameLayout style="@style/LifeConsoleWidgetPreview">
            <ImageView
                android:id="@+id/widget_meal_self_image"
                style="@style/LifeConsoleWidgetImage" />

            <TextView
                android:id="@+id/widget_meal_self_empty"
                style="@style/LifeConsoleWidgetEmpty"
                android:text="点击记录" />

            <TextView
                android:id="@+id/widget_meal_self_open"
                style="@style/LifeConsoleWidgetOpenZone" />

            <TextView
                android:id="@+id/widget_meal_self_prev"
                style="@style/LifeConsoleWidgetEdgeButton"
                android:layout_gravity="start|center_vertical"
                android:text="‹" />

            <TextView
                android:id="@+id/widget_meal_self_next"
                style="@style/LifeConsoleWidgetEdgeButton"
                android:layout_gravity="end|center_vertical"
                android:text="›" />

            <TextView
                android:id="@+id/widget_meal_self_meta"
                style="@style/LifeConsoleWidgetFloatingMeta"
                android:layout_gravity="top|end"
                android:text="0" />

            <TextView
                android:id="@+id/widget_meal_self_upload"
                style="@style/LifeConsoleWidgetFloatingButton"
                android:layout_gravity="bottom|end"
                android:text="+" />

            <TextView
                android:id="@+id/widget_meal_self_delete"
                style="@style/LifeConsoleWidgetFloatingDanger"
                android:layout_gravity="bottom|start"
                android:text="删" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="116dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_bowel_card"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="大便"
                android:textColor="#00BFA5"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="7dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_bowel_peer_strip"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="9dp"
                android:paddingEnd="9dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:gravity="center_vertical"
                    android:text="我"
                    android:textColor="#5F7D89"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_bowel_self_count"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="0"
                    android:textColor="#183B4B"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_bowel_self_latest"
                    android:layout_width="match_parent"
                    android:layout_height="15dp"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:text="今天还没有"
                    android:textColor="#5F7D89"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="58dp"
                android:layout_height="match_parent"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="7dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_bowel_add"
                    android:layout_width="54dp"
                    android:layout_height="34dp"
                    android:background="@drawable/widget_control_dark"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#26313A"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_bowel_remove"
                    android:layout_width="54dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/widget_chip_light"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="#176D90"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_bowel_peer_strip"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="9dp"
                android:paddingEnd="9dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:gravity="end|center_vertical"
                    android:text="对方"
                    android:textColor="#5F7D89"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_bowel_partner_count"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="end|center_vertical"
                    android:text="0"
                    android:textColor="#176D90"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_bowel_partner_latest"
                    android:layout_width="match_parent"
                    android:layout_height="15dp"
                    android:gravity="end|center_vertical"
                    android:singleLine="true"
                    android:text="今天还没有"
                    android:textColor="#5F7D89"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_ledger"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="7dp"
        android:background="@drawable/widget_control_dark"
        android:gravity="center"
        android:text="账本"
        android:textColor="#26313A"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
