<?xml version="1.0" encoding="utf-8"?>
<!--
  今日痕迹 Widget 布局（Review 视觉重做 v5）
  v5：①自己框控件 ‹ [+ 计数 −]居中 › ②大便胶囊加高+新排列(我x + - 对方x) ③记账推到最右
       ④标题更醒目(26sp加粗+强阴影) ⑤爱心间距收紧。Console=横框上下竖排（不重叠）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="5dp"
    android:paddingBottom="4dp">

    <!-- ============ 标题栏 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/widget_open_console"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_title_console"
                android:textColor="@color/widget_title_accent"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/lxgw_wenkai_lite"
                android:shadowColor="@color/white"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="6" />

            <TextView
                android:id="@+id/widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_gold_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="@font/lxgw_wenkai_lite"
                android:shadowColor="@color/white"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="6" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:gravity="center"
            android:minWidth="44dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/widget_status_pending"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10sp"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:padding="8dp"
            android:background="@drawable/widget_refresh_bg"
            android:src="@drawable/widget_icon_refresh"
            android:scaleType="centerInside"
            android:contentDescription="刷新" />
    </LinearLayout>

    <!-- ============ 相框区（自适应铺满）============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:clipChildren="true"
        android:clipToPadding="true">

        <!-- ===== 吃饭·对方框（上，横框，rotation=-1.5°）===== -->
        <FrameLayout
            android:id="@+id/widget_meal_partner_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:clipChildren="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@drawable/widget_polaroid_frame"
                android:rotation="-1.5">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:layout_marginTop="2dp">

                    <ViewFlipper
                        android:id="@+id/widget_meal_partner_flipper"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:inAnimation="@anim/widget_fade_in"
                        android:outAnimation="@anim/widget_fade_out">

                        <ImageView
                            android:id="@+id/widget_meal_partner_image_a"
                            style="@style/LifeConsoleWidgetImage"
                            android:contentDescription="@null" />

                        <ImageView
                            android:id="@+id/widget_meal_partner_image_b"
                            style="@style/LifeConsoleWidgetImage"
                            android:contentDescription="@null" />
                    </ViewFlipper>

                    <TextView
                        android:id="@+id/widget_meal_partner_empty"
                        style="@style/LifeConsoleWidgetEmpty"
                        android:drawableTop="@drawable/widget_empty_camera"
                        android:text="@string/widget_empty_partner" />

                    <TextView
                        android:id="@+id/widget_meal_partner_open"
                        style="@style/LifeConsoleWidgetOpenZone" />
                </FrameLayout>

                <LinearLayout style="@style/LifeConsoleWidgetPolaroidBar">

                    <ImageView
                        android:id="@+id/widget_meal_partner_prev"
                        style="@style/LifeConsoleWidgetEdgeButton"
                        android:src="@drawable/widget_icon_chevron_left"
                        android:contentDescription="上一张" />

                    <TextView
                        android:id="@+id/widget_meal_partner_meta"
                        style="@style/LifeConsoleWidgetFloatingMeta"
                        android:text="0" />

                    <ImageView
                        android:id="@+id/widget_meal_partner_next"
                        style="@style/LifeConsoleWidgetEdgeButton"
                        android:src="@drawable/widget_icon_chevron_right"
                        android:contentDescription="下一张" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                style="@style/LifeConsoleWidgetTape"
                android:src="@drawable/widget_tape_pink"
                android:rotation="-4"
                android:contentDescription="装饰" />
        </FrameLayout>

        <!-- ===== 爱心贴纸（两框之间，收紧间距）===== -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="1dp"
            android:src="@drawable/widget_heart"
            android:contentDescription="装饰" />

        <!-- ===== 吃饭·自己框（下，横框，rotation=+1.5°）===== -->
        <FrameLayout
            android:id="@+id/widget_meal_self_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="6dp"
            android:clipChildren="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@drawable/widget_polaroid_frame"
                android:rotation="1.5">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:layout_marginTop="2dp">

                    <ViewFlipper
                        android:id="@+id/widget_meal_self_flipper"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:inAnimation="@anim/widget_fade_in"
                        android:outAnimation="@anim/widget_fade_out">

                        <ImageView
                            android:id="@+id/widget_meal_self_image_a"
                            style="@style/LifeConsoleWidgetImage"
                            android:contentDescription="@null" />

                        <ImageView
                            android:id="@+id/widget_meal_self_image_b"
                            style="@style/LifeConsoleWidgetImage"
                            android:contentDescription="@null" />
                    </ViewFlipper>

                    <TextView
                        android:id="@+id/widget_meal_self_empty"
                        style="@style/LifeConsoleWidgetEmpty"
                        android:drawableTop="@drawable/widget_empty_plus"
                        android:text="@string/widget_empty_self" />

                    <TextView
                        android:id="@+id/widget_meal_self_open"
                        style="@style/LifeConsoleWidgetOpenZone" />
                </FrameLayout>

                <!-- 自己框控件：‹ [+ 计数 −]居中 › -->
                <LinearLayout style="@style/LifeConsoleWidgetPolaroidBar">

                    <ImageView
                        android:id="@+id/widget_meal_self_prev"
                        style="@style/LifeConsoleWidgetEdgeButton"
                        android:src="@drawable/widget_icon_chevron_left"
                        android:contentDescription="上一张" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/widget_meal_self_upload"
                            style="@style/LifeConsoleWidgetFloatingButton"
                            android:src="@drawable/widget_icon_plus"
                            android:contentDescription="上传" />

                        <TextView
                            android:id="@+id/widget_meal_self_meta"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:minWidth="34dp"
                            android:singleLine="true"
                            android:textColor="@color/widget_text_secondary"
                            android:textSize="11sp"
                            android:text="0" />

                        <ImageView
                            android:id="@+id/widget_meal_self_delete"
                            style="@style/LifeConsoleWidgetFloatingDanger"
                            android:src="@drawable/widget_icon_delete"
                            android:contentDescription="删除" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/widget_meal_self_next"
                        style="@style/LifeConsoleWidgetEdgeButton"
                        android:src="@drawable/widget_icon_chevron_right"
                        android:contentDescription="下一张" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                style="@style/LifeConsoleWidgetTape"
                android:src="@drawable/widget_tape_gold"
                android:rotation="5"
                android:contentDescription="装饰" />
        </FrameLayout>
    </LinearLayout>

    <!-- ============ 底部胶囊栏（大便加高+新排列 我x + - 对方x，记账最右）============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            style="@style/LifeConsoleWidgetBowelCapsule"
            android:layout_height="42dp">

            <TextView
                style="@style/LifeConsoleWidgetBowelLabel"
                android:text="@string/widget_bowel_self_label" />

            <TextView
                android:id="@+id/widget_bowel_self_count"
                style="@style/LifeConsoleWidgetBowelCount"
                android:text="0" />

            <ImageView
                android:id="@+id/widget_bowel_add"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/widget_bowel_plus"
                android:contentDescription="增加" />

            <ImageView
                android:id="@+id/widget_bowel_remove"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/widget_bowel_minus"
                android:contentDescription="减少" />

            <TextView
                style="@style/LifeConsoleWidgetBowelLabel"
                android:layout_marginStart="8dp"
                android:text="@string/widget_bowel_partner_label" />

            <TextView
                android:id="@+id/widget_bowel_partner_count"
                style="@style/LifeConsoleWidgetBowelCount"
                android:text="0" />
        </LinearLayout>

        <!-- 弹性间距：把记账推到最右 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/widget_ledger"
            style="@style/LifeConsoleWidgetLedgerCapsule"
            android:layout_width="34dp"
            android:layout_height="34dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/widget_ledger_icon"
                android:contentDescription="账本" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
