<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDF9FF"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_open_console"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="人物痕迹"
            android:textColor="#183B4B"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/widget_chip_light"
            android:gravity="center"
            android:minWidth="54dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="待刷新"
            android:textColor="#5F7D89"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="54dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_chip_light"
            android:gravity="center"
            android:text="刷新"
            android:textColor="#176D90"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        style="@style/LifePeopleWidgetFrame"
        android:layout_marginTop="8dp">

        <FrameLayout style="@style/LifePeopleWidgetPreview">
            <ImageView
                android:id="@+id/widget_person_partner_image"
                style="@style/LifeConsoleWidgetImage" />

            <TextView
                android:id="@+id/widget_person_partner_empty"
                style="@style/LifeConsoleWidgetEmpty"
                android:text="今天还没有" />

            <TextView
                android:id="@+id/widget_person_partner_open"
                style="@style/LifeConsoleWidgetOpenZone" />

            <TextView
                android:id="@+id/widget_person_partner_prev"
                style="@style/LifeConsoleWidgetEdgeButton"
                android:layout_gravity="start|center_vertical"
                android:text="‹" />

            <TextView
                android:id="@+id/widget_person_partner_next"
                style="@style/LifeConsoleWidgetEdgeButton"
                android:layout_gravity="end|center_vertical"
                android:text="›" />

            <TextView
                android:id="@+id/widget_person_partner_meta"
                style="@style/LifeConsoleWidgetFloatingMeta"
                android:layout_gravity="top|end"
                android:text="0" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        style="@style/LifePeopleWidgetFrame"
        android:layout_marginTop="8dp">

        <FrameLayout style="@style/LifePeopleWidgetPreview">
            <ImageView
                android:id="@+id/widget_person_self_image"
                style="@style/LifeConsoleWidgetImage" />

            <TextView
                android:id="@+id/widget_person_self_empty"
                style="@style/LifeConsoleWidgetEmpty"
                android:text="今天还没有" />

            <TextView
                android:id="@+id/widget_person_self_open"
                style="@style/LifeConsoleWidgetOpenZone" />

            <TextView
                android:id="@+id/widget_person_self_prev"
                style="@style/LifeConsoleWidgetEdgeButton"
                android:layout_gravity="start|center_vertical"
                android:text="‹" />

            <TextView
                android:id="@+id/widget_person_self_next"
                style="@style/LifeConsoleWidgetEdgeButton"
                android:layout_gravity="end|center_vertical"
                android:text="›" />

            <TextView
                android:id="@+id/widget_person_self_meta"
                style="@style/LifeConsoleWidgetFloatingMeta"
                android:layout_gravity="top|end"
                android:text="0" />

            <TextView
                android:id="@+id/widget_person_self_upload"
                style="@style/LifePeopleWidgetUploadButton"
                android:layout_gravity="bottom|end"
                android:text="+" />

            <TextView
                android:id="@+id/widget_person_self_delete"
                style="@style/LifeConsoleWidgetFloatingDanger"
                android:layout_gravity="bottom|start"
                android:text="删" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
