<?xml version="1.0" encoding="utf-8"?>
<!--
  人物痕迹 Widget 布局（Review 视觉重做 v5）
  v5：①侧边置顶热区（右上空白→对方置顶，左下空白→自己置顶）②相纸铺满减少留白
       ③自己框控件 ‹ [+ 计数 −]居中 › ④标题更醒目(加粗+强阴影) ⑤weight自适应+负margin重叠
  People=竖框对角重叠，点击置顶（setElevation 按 front_slot，自己框默认在前）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="3dp"
    android:paddingBottom="0dp">

    <!-- ============ 标题栏 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/widget_open_console"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_title_people"
                android:textColor="@color/widget_title_accent"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/lxgw_wenkai_lite"
                android:shadowColor="@color/white"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="6" />

            <TextView
                android:id="@+id/widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_gold_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="@font/lxgw_wenkai_lite"
                android:shadowColor="@color/white"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="6" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:gravity="center"
            android:minWidth="44dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/widget_status_pending"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10sp"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:padding="8dp"
            android:background="@drawable/widget_refresh_bg"
            android:src="@drawable/widget_icon_refresh"
            android:scaleType="centerInside"
            android:contentDescription="刷新" />
    </LinearLayout>

    <!-- ============ 相框区（weight 自适应 + 负 margin 对角重叠 + 侧边置顶热区）============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:clipChildren="true"
        android:clipToPadding="true">

        <!-- ===== 人物·对方框容器（上，全宽，相纸偏左，右侧留置顶热区）===== -->
        <FrameLayout
            android:id="@+id/widget_person_partner_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:clipChildren="false">

            <!-- 相纸（偏左，右侧留 60dp 空白） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="30dp"
                android:orientation="vertical"
                android:background="@drawable/widget_polaroid_frame"
                android:rotation="-1.5">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:layout_marginTop="2dp">

                    <ViewFlipper
                        android:id="@+id/widget_person_partner_flipper"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:inAnimation="@anim/widget_fade_in"
                        android:outAnimation="@anim/widget_fade_out">

                        <ImageView
                            android:id="@+id/widget_person_partner_image_a"
                            style="@style/LifeConsoleWidgetImage"
                            android:contentDescription="@null" />

                        <ImageView
                            android:id="@+id/widget_person_partner_image_b"
                            style="@style/LifeConsoleWidgetImage"
                            android:contentDescription="@null" />
                    </ViewFlipper>

                    <TextView
                        android:id="@+id/widget_person_partner_empty"
                        style="@style/LifeConsoleWidgetEmpty"
                        android:drawableTop="@drawable/widget_empty_camera"
                        android:text="@string/widget_empty_partner" />

                    <TextView
                        android:id="@+id/widget_person_partner_open"
                        style="@style/LifeConsoleWidgetOpenZone" />
                </FrameLayout>

                <LinearLayout style="@style/LifeConsoleWidgetPolaroidBar">

                    <ImageView
                        android:id="@+id/widget_person_partner_prev"
                        style="@style/LifeConsoleWidgetEdgeButton"
                        android:src="@drawable/widget_icon_chevron_left"
                        android:contentDescription="上一张" />

                    <TextView
                        android:id="@+id/widget_person_partner_meta"
                        style="@style/LifeConsoleWidgetFloatingMeta"
                        android:text="0" />

                    <ImageView
                        android:id="@+id/widget_person_partner_next"
                        style="@style/LifeConsoleWidgetEdgeButton"
                        android:src="@drawable/widget_icon_chevron_right"
                        android:contentDescription="下一张" />
                </LinearLayout>
            </LinearLayout>

            <!-- 胶带 -->
            <ImageView
                style="@style/LifeConsoleWidgetTape"
                android:src="@drawable/widget_tape_mint"
                android:rotation="-6"
                android:contentDescription="装饰" />

            <!-- 右侧置顶热区（点右上空白让对方框置顶） -->
            <FrameLayout
                android:id="@+id/widget_person_partner_bring_front"
                android:layout_width="52dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:clickable="true"
                android:focusable="true" />
        </FrameLayout>

        <!-- ===== 人物·自己框容器（下，全宽，相纸偏右，左侧留置顶热区，负margin重叠）===== -->
        <FrameLayout
            android:id="@+id/widget_person_self_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="-88dp"
            android:clipChildren="false">

            <!-- 相纸（偏右，左侧留 60dp 空白） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="30dp"
                android:orientation="vertical"
                android:background="@drawable/widget_polaroid_frame"
                android:rotation="1">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:layout_marginTop="2dp">

                    <ViewFlipper
                        android:id="@+id/widget_person_self_flipper"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:inAnimation="@anim/widget_fade_in"
                        android:outAnimation="@anim/widget_fade_out">

                        <ImageView
                            android:id="@+id/widget_person_self_image_a"
                            style="@style/LifeConsoleWidgetImage"
                            android:contentDescription="@null" />

                        <ImageView
                            android:id="@+id/widget_person_self_image_b"
                            style="@style/LifeConsoleWidgetImage"
                            android:contentDescription="@null" />
                    </ViewFlipper>

                    <TextView
                        android:id="@+id/widget_person_self_empty"
                        style="@style/LifeConsoleWidgetEmpty"
                        android:drawableTop="@drawable/widget_empty_plus"
                        android:text="@string/widget_empty_self" />

                    <TextView
                        android:id="@+id/widget_person_self_open"
                        style="@style/LifeConsoleWidgetOpenZone" />
                </FrameLayout>

                <!-- 自己框控件：‹ [+ 计数 −]居中 › -->
                <LinearLayout style="@style/LifeConsoleWidgetPolaroidBar">

                    <ImageView
                        android:id="@+id/widget_person_self_prev"
                        style="@style/LifeConsoleWidgetEdgeButton"
                        android:src="@drawable/widget_icon_chevron_left"
                        android:contentDescription="上一张" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/widget_person_self_upload"
                            style="@style/LifePeopleWidgetUploadButton"
                            android:src="@drawable/widget_icon_plus"
                            android:contentDescription="上传" />

                        <TextView
                            android:id="@+id/widget_person_self_meta"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:minWidth="34dp"
                            android:singleLine="true"
                            android:textColor="@color/widget_text_secondary"
                            android:textSize="11sp"
                            android:text="0" />

                        <ImageView
                            android:id="@+id/widget_person_self_delete"
                            style="@style/LifeConsoleWidgetFloatingDanger"
                            android:src="@drawable/widget_icon_delete"
                            android:contentDescription="删除" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/widget_person_self_next"
                        style="@style/LifeConsoleWidgetEdgeButton"
                        android:src="@drawable/widget_icon_chevron_right"
                        android:contentDescription="下一张" />
                </LinearLayout>
            </LinearLayout>

            <!-- 胶带 -->
            <ImageView
                style="@style/LifeConsoleWidgetTape"
                android:src="@drawable/widget_tape_blue"
                android:rotation="5"
                android:contentDescription="装饰" />

            <!-- 爱心贴纸（重叠区，自己框上沿） -->
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="-15dp"
                android:src="@drawable/widget_heart"
                android:contentDescription="装饰" />

            <!-- 左侧置顶热区（点左下空白让自己框置顶） -->
            <FrameLayout
                android:id="@+id/widget_person_self_bring_front"
                android:layout_width="52dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:clickable="true"
                android:focusable="true" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
