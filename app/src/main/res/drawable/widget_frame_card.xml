<?xml version="1.0" encoding="utf-8"?>
<!-- Card frame: enhanced outer glow + saturated blue gradient + bright highlight + hairline border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow ring — stronger for more depth -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#3090C0E8" />
        </shape>
    </item>
    <!-- Main card body with more saturated diagonal gradient -->
    <item
        android:left="1.5dp"
        android:top="1.5dp"
        android:right="1.5dp"
        android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:startColor="#EAF6FF"
                android:endColor="#D0E8F8"
                android:angle="135" />
        </shape>
    </item>
    <!-- Top-left highlight sheen — brighter -->
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:startColor="#70FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="135" />
        </shape>
    </item>
    <!-- Inner hairline border — slightly stronger -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <stroke
                android:width="0.8dp"
                android:color="#6090C8E8" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</layer-list>
