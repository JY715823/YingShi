<?xml version="1.0" encoding="utf-8"?>
<!-- Bowel card: enhanced layered depth with stronger teal/cyan accent -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer shadow — stronger for more depth -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#3870C0D0" />
        </shape>
    </item>
    <!-- Main body: more saturated teal gradient -->
    <item
        android:left="1.5dp"
        android:top="1.5dp"
        android:right="1.5dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:startColor="#B8E8F4"
                android:endColor="#88D8EC"
                android:angle="135" />
        </shape>
    </item>
    <!-- Inner glow top — brighter -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="23dp" />
            <gradient
                android:startColor="#50FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="90" />
        </shape>
    </item>
    <!-- Hairline inner border -->
    <item
        android:left="2.5dp"
        android:top="2.5dp"
        android:right="2.5dp"
        android:bottom="2.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="23dp" />
            <stroke
                android:width="0.8dp"
                android:color="#6090D0E0" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</layer-list>
