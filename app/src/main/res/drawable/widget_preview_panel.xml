<?xml version="1.0" encoding="utf-8"?>
<!-- Preview panel: enhanced inner area with stronger depth gradient -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base fill — more saturated blue -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:startColor="#D4EEFA"
                android:endColor="#B8DEF0"
                android:angle="135" />
        </shape>
    </item>
    <!-- Stronger inner shadow at top for depth -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:startColor="#30FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#18000000"
                android:angle="90" />
        </shape>
    </item>
    <!-- Hairline border — slightly stronger -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <stroke
                android:width="0.6dp"
                android:color="#5088C0D0" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</layer-list>
