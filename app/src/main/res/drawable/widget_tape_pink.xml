<?xml version="1.0" encoding="utf-8"?>
<!--
  和纸胶带-粉色（FR-1 装饰）
  45° 条纹 layer-list
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 底色 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_tape_pink" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <!-- 45° 条纹 -->
    <item>
        <rotate android:fromDegrees="45" android:toDegrees="45" android:pivotX="50%" android:pivotY="50%">
            <shape android:shape="rectangle">
                <size android:width="44dp" android:height="60dp" />
                <gradient
                    android:startColor="@color/widget_tape_pink_stripe"
                    android:centerColor="@color/widget_tape_pink"
                    android:endColor="@color/widget_tape_pink_stripe"
                    android:angle="0" />
            </shape>
        </rotate>
    </item>
</layer-list>
