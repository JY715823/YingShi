<?xml version="1.0" encoding="utf-8"?>
<!-- Light chip: capsule with soft blue gradient -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient
                android:startColor="#D8F0FA"
                android:endColor="#C0E4F4"
                android:angle="135" />
        </shape>
    </item>
    <!-- Top sheen -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient
                android:startColor="#50FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="90" />
        </shape>
    </item>
    <!-- Hairline border -->
    <item
        android:left="0.5dp"
        android:top="0.5dp"
        android:right="0.5dp"
        android:bottom="0.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <stroke
                android:width="0.6dp"
                android:color="#6098C8E0" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</layer-list>
