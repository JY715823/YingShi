<?xml version="1.0" encoding="utf-8"?>
<!-- Dark control: green capsule with gradient depth for action buttons -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow layer -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#3090C8A0" />
        </shape>
    </item>
    <!-- Main body: green gradient -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient
                android:startColor="#C8F0D8"
                android:endColor="#98D8B8"
                android:angle="135" />
        </shape>
    </item>
    <!-- Top highlight -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient
                android:startColor="#50FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="90" />
        </shape>
    </item>
    <!-- Hairline border -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <stroke
                android:width="0.6dp"
                android:color="#6080C0A0" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</layer-list>
