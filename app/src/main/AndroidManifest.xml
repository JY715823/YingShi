<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Round 8 第十四轮: ACCESS_MEDIA_LOCATION — Android 10+ 必须声明此权限才能从 MediaStore/Photo Picker
         读取照片的 EXIF GPS 坐标. 没有此权限时, MediaProvider 会主动 redact EXIF GPS 字节范围,
         导致相册上传永远读不到位置 (即使照片本身有 GPS). 这是一个 install-time 权限 (普通权限),
         不需要运行时请求, 装上就自动生效. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- FR-19: Location used by LifeConsole for tagging media/bowel events; silently skipped when not granted. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".YingShiApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.YingShi">
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id" />

        <!-- Round 7: 高德地图 Android key (位置选择页 E2) -->
        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="${AMAP_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.YingShi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.example.yingshi.action.OPEN_PHOTO_FEED" />
                <action android:name="com.example.yingshi.action.OPEN_SMALL_ALBUM" />
                <action android:name="com.example.yingshi.action.OPEN_LIFE_CONSOLE" />
                <action android:name="com.example.yingshi.action.OPEN_LEDGER" />
                <action android:name="com.example.yingshi.action.OPEN_LEDGER_ADD" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".feature.life.WidgetMediaEntryActivity"
            android:exported="false"
            android:label="@string/life_console_widget_description"
            android:excludeFromRecents="true"
            android:taskAffinity="${applicationId}.widget"
            android:theme="@style/Theme.YingShi" />

        <activity
            android:name=".feature.life.LifeMediaQuickViewerActivity"
            android:exported="false"
            android:label="@string/life_console_widget_description"
            android:excludeFromRecents="true"
            android:taskAffinity="${applicationId}.widget"
            android:theme="@style/Theme.YingShi" />

        <!-- Round 7 阶段 7: 位置选择页 -->
        <activity
            android:name=".feature.life.LifeLocationPickerActivity"
            android:exported="false"
            android:label="选择位置"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.YingShi" />

        <activity
            android:name=".feature.life.LifePushDispatchActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="${applicationId}.widget"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <receiver
            android:name=".feature.life.widget.LifeConsoleWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/life_console_widget_info" />
        </receiver>

        <receiver
            android:name=".feature.life.widget.LifePeopleWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/life_people_widget_info" />
        </receiver>

        <service
            android:name=".feature.chat.ChatImportForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".feature.life.push.YingShiFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".feature.life.push.LifePushDismissReceiver"
            android:exported="false" />

        <!-- R3-AND-002: Internal keepalive receiver (exported=false, not reachable from outside) -->
        <receiver
            android:name=".feature.life.push.SseInternalKeepAliveReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.yingshi.action.SSE_KEEPALIVE" />
            </intent-filter>
        </receiver>

        <!-- R3-AND-002: System broadcast receiver for boot/upgrade (exported=true, system-only actions) -->
        <receiver
            android:name=".feature.life.push.SseKeepAliveReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
